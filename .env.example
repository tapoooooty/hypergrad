# Copy this file to .env and fill it in. Never commit or share .env.

# testnet or mainnet
HL_NETWORK=testnet
# Mainnet also needs an explicit opt-in:
HL_ALLOW_MAINNET=no

# Deployer wallet key (the wallet holding the 500k HYPE stake). An API/agent wallet is preferred.
HL_PRIVATE_KEY=
# Main account address, if HL_PRIVATE_KEY belongs to an agent wallet
HL_ACCOUNT_ADDRESS=

# Separate oracle key (recommended). Put its address in config.json -> dex.oracle_updater.
# If empty, the oracle signs with the deployer key.
HL_ORACLE_PRIVATE_KEY=

# Telegram alerts: token from @BotFather and your chat id (find it with: python -m hip3 tg-chatid)
# Several recipients: comma-separated. Group chat ids start with a minus sign.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Market maker account (separate from the deployer, funded with USDC on Hyperliquid)
HL_MM_PRIVATE_KEY=
HL_MM_ACCOUNT_ADDRESS=

# Optional: Jupiter API key from portal.jup.ag for higher price API limits
JUPITER_API_KEY=
