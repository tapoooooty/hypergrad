# Alternative to Docker. Install: cp deploy/systemd/*.service /etc/systemd/system/ && systemctl enable --now hypergrad-mm
[Unit]
Description=HyperGrad mm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hypergrad
WorkingDirectory=/opt/hypergrad
ExecStart=/opt/hypergrad/.venv/bin/python -m hip3 mm
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
